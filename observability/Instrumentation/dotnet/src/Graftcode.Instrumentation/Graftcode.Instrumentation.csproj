<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Graftcode.Instrumentation</AssemblyName>
    <RootNamespace>Graftcode.Instrumentation</RootNamespace>
    <Version>1.0.0</Version>
    <PackageId>Graftcode.Instrumentation</PackageId>
    <Title>Graftcode Instrumentation</Title>
    <Authors>Graftcode S.A.</Authors>
    <Company>Graftcode S.A.</Company>
    <Description>OpenTelemetry spans and ILogger forwarding for Graftcode invocations</Description>
    <PackageTags>Graftcode;OpenTelemetry;Logging</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/grft-dev/graftcode-extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/grft-dev/graftcode-extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <UseHypertubeUtilsProject Condition="'$(UseHypertubeUtilsProject)' == ''">false</UseHypertubeUtilsProject>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.5" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHypertubeUtilsProject)' != 'true'">
    <PackageReference Include="Hypertube.Netcore.Utils" Version="*" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHypertubeUtilsProject)' == 'true'">
    <ProjectReference Include="$(HypertubeUtilsProject)" Condition="'$(HypertubeAssemblyVersion)' == ''" />
    <ProjectReference Include="$(HypertubeUtilsProject)" Condition="'$(HypertubeAssemblyVersion)' != ''" AdditionalProperties="AssemblyVersion=$(HypertubeAssemblyVersion);FileVersion=$(HypertubeAssemblyVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Graftcode.Instrumentation.Tests" />
  </ItemGroup>
</Project>


