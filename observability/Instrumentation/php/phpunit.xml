<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnNotice="true">
    <testsuites>
        <testsuite name="Graftcode.Instrumentation">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="HYPERTUBE_LOG_ASYNC" value="false"/>
        <env name="OTEL_PHP_AUTOLOAD_ENABLED" value="false"/>
    </php>
</phpunit>
